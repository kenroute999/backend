# Copy this file to `.env` and fill in the values. `.env` is never committed.

# PostgreSQL connection strings. Create the two databases first:
#   createdb kenroute_dev
#   createdb kenroute_test
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kenroute_dev
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kenroute_dev
# Tests run only against this database and refuse to start if it equals DATABASE_URL.
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kenroute_test

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Passenger phone numbers and ID proofs are encrypted with this key. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing ENCRYPTION_KEY makes stored passenger details unreadable; never change it once data exists.
ENCRYPTION_KEY=
PHONE_HASH_KEY=

PORT=5000
NODE_ENV=development

# Optional: comma-separated web origins allowed to call the API.
# Defaults to http://127.0.0.1 and http://localhost on ports 3001, 3002, 3003.
# CORS_ORIGINS=

# Email (optional). Support tickets are always saved; with these three set, a copy is
# also emailed. SMTP_PASS is a Gmail "app password" (Google Account -> Security ->
# 2-Step Verification -> App passwords), never the normal Gmail password.
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=
